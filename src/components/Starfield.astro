---
// Ambient starfield for the big-word panels. Only visible in the modern theme.
---
<canvas class="starfield" aria-hidden="true"></canvas>

<style>
  .starfield {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  :global(html[data-theme='modern']) .starfield {
    display: block;
  }
  :global(html[data-theme='modern'] .panel:has(> .starfield)::after) {
    animation: starfield-grid-drift 36s linear infinite;
  }
  @keyframes starfield-grid-drift {
    to {
      background-position: 48px -48px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html[data-theme='modern'] .panel:has(> .starfield)::after) {
      animation: none;
    }
  }
</style>

<script>
  type Star = { x: number; y: number; r: number; vx: number; vy: number; a: number; tw: number; ph: number; hue: number };

  const root = document.documentElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('canvas.starfield')) {
    const ctx = canvas.getContext('2d');
    if (!ctx) continue;
    let w = 0;
    let h = 0;
    let stars: Star[] = [];
    let raf = 0;
    let last = 0;
    let visible = true;

    const seed = () => {
      const count = Math.round(Math.min(110, Math.max(40, (w * h) / 9000)));
      stars = Array.from({ length: count }, () => {
        const big = Math.random() < 0.12;
        return {
          x: Math.random() * w,
          y: Math.random() * h,
          r: big ? 1.1 + Math.random() * 0.8 : 0.4 + Math.random() * 0.7,
          vx: (Math.random() - 0.5) * 3,
          vy: -(1 + Math.random() * 3),
          a: big ? 0.55 : 0.18 + Math.random() * 0.3,
          tw: 0.4 + Math.random() * 1.2,
          ph: Math.random() * Math.PI * 2,
          hue: [265, 190, 320, 0][Math.floor(Math.random() * 4)],
        };
      });
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      if (!w || !h) return;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
      draw(0, 0);
    };

    const draw = (t: number, dt: number) => {
      ctx.clearRect(0, 0, w, h);
      for (const s of stars) {
        s.x += s.vx * dt;
        s.y += s.vy * dt;
        if (s.y < -4) s.y = h + 4;
        if (s.x < -4) s.x = w + 4;
        else if (s.x > w + 4) s.x = -4;
        const alpha = s.a * (0.55 + 0.45 * Math.sin(t * s.tw + s.ph));
        const color = s.hue ? `hsla(${s.hue}, 90%, 85%, ${alpha})` : `rgba(255, 255, 255, ${alpha})`;
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fill();
        if (s.r > 1.1) {
          ctx.shadowColor = color;
          ctx.shadowBlur = 8;
          ctx.fill();
          ctx.shadowBlur = 0;
        }
      }
    };

    const frame = (now: number) => {
      const dt = last ? Math.min((now - last) / 1000, 0.1) : 0;
      last = now;
      draw(now / 1000, dt);
      raf = requestAnimationFrame(frame);
    };

    const sync = () => {
      const run = root.dataset.theme === 'modern' && visible && !document.hidden && !reduce.matches;
      if (root.dataset.theme === 'modern' && !w) resize();
      if (run && !raf) {
        last = 0;
        raf = requestAnimationFrame(frame);
      } else if (!run && raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    };

    new ResizeObserver(() => {
      if (root.dataset.theme === 'modern') resize();
    }).observe(canvas);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      sync();
    }).observe(canvas);
    new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
    document.addEventListener('visibilitychange', sync);
    reduce.addEventListener('change', sync);
    sync();
  }
</script>
