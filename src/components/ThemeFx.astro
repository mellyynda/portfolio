---
// Theme switch reveal (all themes) plus modern-only scroll reveal and cursor spotlight.
---
<div class="fx-spotlight" aria-hidden="true"></div>

<style is:global>
  /* circular reveal when switching themes (driven by document.startViewTransition in Base.astro) */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
  ::view-transition-new(root) {
    animation: fx-theme-reveal 0.75s cubic-bezier(0.7, 0, 0.2, 1);
  }
  @keyframes fx-theme-reveal {
    from {
      clip-path: circle(0 at var(--reveal-x, 100%) var(--reveal-y, 0));
    }
    to {
      clip-path: circle(var(--reveal-r, 150vmax) at var(--reveal-x, 100%) var(--reveal-y, 0));
    }
  }

  /* scroll reveal: .fx-reveal is only added by JS, so content stays visible without it */
  html[data-theme='modern'] .fx-reveal {
    transition:
      opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--fx-i, 0) * 70ms);
  }
  html[data-theme='modern'] .fx-reveal:not(.fx-in) {
    opacity: 0;
    transform: translateY(28px);
    filter: blur(6px);
  }

  /* cursor spotlight */
  .fx-spotlight {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    html[data-theme='modern'] .fx-spotlight {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 20;
      width: 640px;
      height: 640px;
      margin: -320px 0 0 -320px;
      border-radius: 50%;
      pointer-events: none;
      background: radial-gradient(circle, rgb(167 139 250 / 0.16), rgb(34 211 238 / 0.06) 40%, transparent 70%);
      mix-blend-mode: screen;
      opacity: 0;
      transform: translate3d(var(--fx-x, -999px), var(--fx-y, -999px), 0);
      transition: opacity 0.4s;
      will-change: transform;
    }
    html[data-theme='modern'] .fx-spotlight.on {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-new(root) {
      animation: none;
    }
    html[data-theme='modern'] .fx-reveal,
    html[data-theme='modern'] .fx-reveal:not(.fx-in) {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
    html[data-theme='modern'] .fx-spotlight {
      display: none;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if ('IntersectionObserver' in window) {
    const groups = [
      '.stats > div',
      '.prose > p',
      '.projects > .project',
      '.timeline > .job',
      '.skill-group',
      '.contact-links > li',
      '.split-sec > .content > *',
    ];
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('fx-in');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    const seen = new Set<Element>();
    for (const sel of groups) {
      for (const el of document.querySelectorAll<HTMLElement>(sel)) {
        if (seen.has(el) || el.querySelector('.fx-reveal') || el.closest('.fx-reveal')) continue;
        seen.add(el);
        const i = el.parentElement ? Array.prototype.indexOf.call(el.parentElement.children, el) : 0;
        el.style.setProperty('--fx-i', String(Math.min(i, 6)));
        el.classList.add('fx-reveal');
        io.observe(el);
      }
    }
  }

  const spot = document.querySelector<HTMLElement>('.fx-spotlight');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  if (spot && fine.matches) {
    let x = 0;
    let y = 0;
    let queued = false;
    const paint = () => {
      queued = false;
      spot.style.setProperty('--fx-x', `${x}px`);
      spot.style.setProperty('--fx-y', `${y}px`);
    };
    document.addEventListener(
      'pointermove',
      (e) => {
        if (document.documentElement.dataset.theme !== 'modern' || reduce.matches) return;
        x = e.clientX;
        y = e.clientY;
        spot.classList.add('on');
        if (!queued) {
          queued = true;
          requestAnimationFrame(paint);
        }
      },
      { passive: true },
    );
    document.documentElement.addEventListener('pointerleave', () => spot.classList.remove('on'));
  }
</script>
