---
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '@fontsource-variable/manrope';
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '@fontsource-variable/fraunces/soft.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/global.css';
import '../styles/retro.css';
import { SITE_URL, EMAIL, LINKEDIN, GITHUB, paths, asset, type Content } from '../data/content';

interface Props {
  c: Content;
}
const { c } = Astro.props;
const lang = c.lang;
const url = SITE_URL + paths[lang];
const altLang = lang === 'en' ? 'sv' : 'en';
const ogImage = `${SITE_URL}/og.png`;
const themeIds = ['classic', 'modern', 'accessible'] as const;

const current = c.jobs[0].roles[0];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: 'Melinda Sava',
      jobTitle: [...new Set([...c.role, current.title])],
      description: c.description,
      email: `mailto:${EMAIL}`,
      url: SITE_URL + '/',
      image: ogImage,
      sameAs: [LINKEDIN, GITHUB],
      address: { '@type': 'PostalAddress', addressLocality: 'Stockholm', addressCountry: 'SE' },
      worksFor: { '@type': 'Organization', name: 'Worldline / PaymentIQ' },
      knowsLanguage: [
        { '@type': 'Language', name: 'English', alternateName: 'en' },
        { '@type': 'Language', name: 'Swedish', alternateName: 'sv' },
      ],
      knowsAbout: c.skills.flatMap((g) => g.items).concat(['Fintech', 'Payment platforms', 'Engineering management']),
      alumniOf: [
        { '@type': 'EducationalOrganization', name: 'KYH Yrkeshögskola' },
        { '@type': 'EducationalOrganization', name: 'Mihai Viteazul National Intelligence Academy' },
      ],
      hasOccupation: c.jobs.flatMap((j) =>
        j.roles.map((r) => ({
          '@type': 'Role',
          roleName: r.title,
          startDate: r.start,
          ...(r.end ? { endDate: r.end } : {}),
          memberOf: { '@type': 'Organization', name: j.org },
        })),
      ),
    },
    {
      '@type': 'ProfilePage',
      '@id': `${url}#page`,
      url,
      name: c.title,
      inLanguage: lang,
      dateModified: new Date().toISOString().slice(0, 10),
      mainEntity: { '@id': `${SITE_URL}/#person` },
    }
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.title}</title>
    <meta name="description" content={c.description} />
    <meta name="author" content="Melinda Sava" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="en" href={SITE_URL + paths.en} />
    <link rel="alternate" hreflang="sv" href={SITE_URL + paths.sv} />
    <link rel="alternate" hreflang="x-default" href={SITE_URL + paths.en} />
    <meta name="geo.region" content="SE-AB" />
    <meta name="geo.placename" content="Stockholm" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf3e7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d1117" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={c.title} />
    <meta property="og:description" content={c.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={c.locale} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'sv_SE' : 'en_SE'} />
    <meta property="profile:first_name" content="Melinda" />
    <meta property="profile:last_name" content="Sava" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href={asset('/sitemap.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'modern' || t === 'accessible') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : 'Hoppa till innehåll'}</a>
    <nav class="home-nav" aria-label={lang === 'en' ? 'Home' : 'Startsida'}>
      <a class="mark" href={asset(paths[lang])} aria-label="Melinda Sava">.Mel</a>
    </nav>
    <header class="chrome">
      <div class="chrome-right">
        <div class="theme-switch">
          <button class="theme-pill" type="button" aria-expanded="false" aria-controls="theme-menu">
            <span class="theme-pill-k">{c.themes.label}<span class="sr-only">:</span></span>
            {themeIds.map((id) => <span class="theme-pill-v" data-theme-name={id} hidden={id !== 'classic'}>{c.themes[id].name}</span>)}
            <span class="theme-pill-caret" aria-hidden="true">▾</span>
          </button>
          <div id="theme-menu" class="theme-menu" hidden>
            <fieldset>
              <legend>{c.themes.legend}</legend>
              {themeIds.map((id) => (
                <label class="theme-opt">
                  <input type="radio" name="theme" value={id} checked={id === 'classic'} aria-describedby={`theme-${id}-desc`} />
                  <span class="theme-opt-text">
                    <span class="theme-opt-name">{c.themes[id].name}</span>
                    <span class="theme-opt-desc" id={`theme-${id}-desc`}>{c.themes[id].desc}</span>
                  </span>
                </label>
              ))}
            </fieldset>
          </div>
        </div>
        <a class="lang-pill" href={asset(paths[altLang])} hreflang={altLang} lang={altLang} aria-label={c.nav.switchLabel} title={c.nav.switchHint}>{altLang.toUpperCase()}</a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-open={c.menuLabel} data-close={c.closeLabel} aria-label={c.menuLabel}>
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>
    <nav id="site-menu" class="menu" aria-label={lang === 'en' ? 'Main' : 'Huvudmeny'}>
      <ol>
        <li><a href="#top"><span class="n">01</span>{c.homeLabel}</a></li>
        <li><a href="#about"><span class="n">02</span>{c.nav.about}</a></li>
        <li><a href="#projects"><span class="n">03</span>{c.nav.projects}</a></li>
        <li><a href="#work"><span class="n">04</span>{c.nav.work}</a></li>
        <li><a href="#skills"><span class="n">05</span>{c.nav.skills}</a></li>
        <li><a href="#contact"><span class="n">06</span>{c.nav.contact}</a></li>
      </ol>
      <a class="menu-lang" href={asset(paths[altLang])} hreflang={altLang} lang={altLang}>{c.nav.switchLabel} →</a>
    </nav>
    <slot />
    <aside class="vibe" aria-labelledby="vibe-q" hidden>
      <button class="vibe-close" type="button" aria-label={c.vibe.close}>×</button>
      <p id="vibe-q" class="vibe-q">{c.vibe.question}</p>
      <p class="vibe-hint">{c.vibe.hint}</p>
      <div class="vibe-actions">
        <button class="btn btn-primary" type="button" data-pick="modern">{c.vibe.makeModern}</button>
        <button class="btn" type="button" data-pick="accessible">{c.vibe.makeAccessible}</button>
        <button class="btn" type="button" data-pick="classic">{c.vibe.dismiss}</button>
      </div>
    </aside>
    <script>
      type Theme = 'classic' | 'modern' | 'accessible';
      const themes: Theme[] = ['classic', 'modern', 'accessible'];
      const root = document.documentElement;
      const pill = document.querySelector<HTMLButtonElement>('.theme-pill');
      const panel = document.getElementById('theme-menu');
      const radios = Array.from(document.querySelectorAll<HTMLInputElement>('#theme-menu input[name="theme"]'));
      const vibe = document.querySelector<HTMLElement>('.vibe');
      const store = {
        get: () => {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        },
        set: (v: string) => {
          try {
            localStorage.setItem('theme', v);
          } catch {}
        },
      };
      const current = (): Theme => (themes.includes(root.dataset.theme as Theme) ? (root.dataset.theme as Theme) : 'classic');
      const apply = (theme: Theme) => {
        if (theme === 'classic') delete root.dataset.theme;
        else root.dataset.theme = theme;
        for (const r of radios) r.checked = r.value === theme;
        for (const el of document.querySelectorAll<HTMLElement>('.theme-pill-v')) el.hidden = el.dataset.themeName !== theme;
        document.dispatchEvent(new CustomEvent('themechange', { detail: theme }));
      };
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let lastPointer: { x: number; y: number } | null = null;
      document.addEventListener('pointerdown', (e) => (lastPointer = { x: e.clientX, y: e.clientY }), { capture: true });
      document.addEventListener('keydown', () => (lastPointer = null), { capture: true });
      const setTheme = (theme: Theme) => {
        const run = () => {
          apply(theme);
          store.set(theme);
        };
        if (theme === current() || reduceMotion.matches || !document.startViewTransition) return run();
        const r = pill?.getBoundingClientRect();
        const x = lastPointer?.x ?? (r ? r.left + r.width / 2 : innerWidth);
        const y = lastPointer?.y ?? (r ? r.top + r.height / 2 : 0);
        root.style.setProperty('--reveal-x', `${x}px`);
        root.style.setProperty('--reveal-y', `${y}px`);
        root.style.setProperty('--reveal-r', `${Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))}px`);
        document.startViewTransition(run);
      };
      apply(current());

      const open = (show: boolean, refocus = false) => {
        if (!pill || !panel) return;
        panel.hidden = !show;
        pill.setAttribute('aria-expanded', String(show));
        if (show) (radios.find((r) => r.checked) ?? radios[0])?.focus();
        else if (refocus) pill.focus();
      };
      let pointerPick = false;
      pill?.addEventListener('click', () => {
        open(pill.getAttribute('aria-expanded') !== 'true');
        if (vibe) vibe.hidden = true;
      });
      panel?.addEventListener('pointerdown', () => (pointerPick = true));
      panel?.addEventListener('keydown', (e) => {
        pointerPick = false;
        if (e.key === 'Escape') {
          e.preventDefault();
          open(false, true);
        } else if (e.key === 'Enter' && e.target instanceof HTMLInputElement) {
          e.preventDefault();
          open(false, true);
        }
      });
      for (const r of radios) {
        r.addEventListener('change', () => {
          if (!r.checked) return;
          setTheme(r.value as Theme);
          if (pointerPick) open(false, true);
          pointerPick = false;
        });
      }
      document.addEventListener('pointerdown', (e) => {
        if (panel && !panel.hidden && !(e.target as Element).closest('.theme-switch')) open(false);
      });
      document.querySelector('.theme-switch')?.addEventListener('focusout', (e) => {
        const next = (e as FocusEvent).relatedTarget as Node | null;
        if (next && !(e.currentTarget as HTMLElement).contains(next)) open(false);
      });

      // Opt-in only: the theme prompt never opens on its own, so the first view stays on the content.
      // Add ?theme-prompt to the URL to show it.
      if (vibe && new URLSearchParams(location.search).has('theme-prompt')) {
        const close = (theme: Theme) => {
          setTheme(theme);
          vibe.hidden = true;
          pill?.focus();
        };
        vibe.hidden = false;
        for (const b of vibe.querySelectorAll<HTMLButtonElement>('[data-pick]')) {
          b.addEventListener('click', () => close(b.dataset.pick as Theme));
        }
        vibe.querySelector<HTMLButtonElement>('.vibe-close')?.addEventListener('click', () => close('classic'));
        vibe.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') close('classic');
        });
      }
    </script>
    <script>
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const menu = document.getElementById('site-menu');
      if (btn && menu) {
        const set = (open: boolean) => {
          btn.setAttribute('aria-expanded', String(open));
          btn.setAttribute('aria-label', (open ? btn.dataset.close : btn.dataset.open) ?? '');
          document.documentElement.classList.toggle('menu-open', open);
          for (const el of document.querySelectorAll<HTMLElement>('main, footer, .skip, .home-nav, .lang-pill, .theme-switch, .vibe')) el.inert = open;
          if (open) menu.querySelector('a')?.focus();
        };
        btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
        menu.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) set(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
            set(false);
            btn.focus();
          }
        });
      }
    </script>
  </body>
</html>
