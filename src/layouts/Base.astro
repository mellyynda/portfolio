---
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { SITE_URL, EMAIL, LINKEDIN, GITHUB, paths, asset, type Content } from '../data/content';

interface Props {
  c: Content;
}
const { c } = Astro.props;
const lang = c.lang;
const url = SITE_URL + paths[lang];
const altLang = lang === 'en' ? 'sv' : 'en';
const ogImage = `${SITE_URL}/og.png`;

const current = c.jobs[0].roles[0];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: 'Melinda Sava',
      jobTitle: [c.role, current.title],
      description: c.description,
      email: `mailto:${EMAIL}`,
      url: SITE_URL + '/',
      image: ogImage,
      sameAs: [LINKEDIN, GITHUB],
      address: { '@type': 'PostalAddress', addressLocality: 'Stockholm', addressCountry: 'SE' },
      worksFor: { '@type': 'Organization', name: 'Worldline / PaymentIQ' },
      knowsLanguage: [
        { '@type': 'Language', name: 'English', alternateName: 'en' },
        { '@type': 'Language', name: 'Swedish', alternateName: 'sv' },
      ],
      knowsAbout: c.skills.flatMap((g) => g.items).concat(['Fintech', 'Payment platforms', 'Engineering management']),
      alumniOf: [
        { '@type': 'EducationalOrganization', name: 'KYH Yrkeshögskola' },
        { '@type': 'EducationalOrganization', name: 'Mihai Viteazul National Intelligence Academy' },
      ],
      hasOccupation: c.jobs.flatMap((j) =>
        j.roles.map((r) => ({
          '@type': 'Role',
          roleName: r.title,
          startDate: r.start,
          ...(r.end ? { endDate: r.end } : {}),
          memberOf: { '@type': 'Organization', name: j.org },
        })),
      ),
    },
    {
      '@type': 'ProfilePage',
      '@id': `${url}#page`,
      url,
      name: c.title,
      inLanguage: lang,
      dateModified: new Date().toISOString().slice(0, 10),
      mainEntity: { '@id': `${SITE_URL}/#person` },
    }
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.title}</title>
    <meta name="description" content={c.description} />
    <meta name="author" content="Melinda Sava" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="en" href={SITE_URL + paths.en} />
    <link rel="alternate" hreflang="sv" href={SITE_URL + paths.sv} />
    <link rel="alternate" hreflang="x-default" href={SITE_URL + paths.en} />
    <meta name="geo.region" content="SE-AB" />
    <meta name="geo.placename" content="Stockholm" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf3e7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d1117" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={c.title} />
    <meta property="og:description" content={c.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={c.locale} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'sv_SE' : 'en_SE'} />
    <meta property="profile:first_name" content="Melinda" />
    <meta property="profile:last_name" content="Sava" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href={asset('/sitemap.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'modern') document.documentElement.dataset.theme = 'modern';
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : 'Hoppa till innehåll'}</a>
    <nav class="home-nav" aria-label={lang === 'en' ? 'Home' : 'Startsida'}>
      <a class="mark" href={asset(paths[lang])} aria-label="Melinda Sava">.Mel</a>
    </nav>
    <header class="chrome">
      <div class="chrome-right">
        <button
          class="theme-pill"
          type="button"
          aria-pressed="false"
          data-to-modern={c.vibe.toModern}
          data-to-classic={c.vibe.toClassic}
          data-modern-short={c.vibe.modernShort}
          data-classic-short={c.vibe.classicShort}
          aria-label={c.vibe.toModern}
          title={c.vibe.toModern}
        >{c.vibe.modernShort}</button>
        <a class="lang-pill" href={asset(paths[altLang])} hreflang={altLang} lang={altLang} aria-label={c.nav.switchLabel} title={c.nav.switchHint}>{altLang.toUpperCase()}</a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-open={c.menuLabel} data-close={c.closeLabel} aria-label={c.menuLabel}>
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>
    <nav id="site-menu" class="menu" aria-label={lang === 'en' ? 'Main' : 'Huvudmeny'}>
      <ol>
        <li><a href="#top"><span class="n">01</span>{c.homeLabel}</a></li>
        <li><a href="#about"><span class="n">02</span>{c.nav.about}</a></li>
        <li><a href="#projects"><span class="n">03</span>{c.nav.projects}</a></li>
        <li><a href="#work"><span class="n">04</span>{c.nav.work}</a></li>
        <li><a href="#skills"><span class="n">05</span>{c.nav.skills}</a></li>
        <li><a href="#contact"><span class="n">06</span>{c.nav.contact}</a></li>
      </ol>
      <a class="menu-lang" href={asset(paths[altLang])} hreflang={altLang} lang={altLang}>{c.nav.switchLabel} →</a>
    </nav>
    <slot />
    <aside class="vibe" aria-labelledby="vibe-q" hidden>
      <button class="vibe-close" type="button" aria-label={c.vibe.close}>×</button>
      <p id="vibe-q" class="vibe-q">{c.vibe.question}</p>
      <p class="vibe-hint">{c.vibe.hint}</p>
      <div class="vibe-actions">
        <button class="btn btn-primary vibe-go" type="button">{c.vibe.makeModern}</button>
        <button class="btn vibe-no" type="button">{c.vibe.dismiss}</button>
      </div>
    </aside>
    <script>
      const root = document.documentElement;
      const pill = document.querySelector<HTMLButtonElement>('.theme-pill');
      const vibe = document.querySelector<HTMLElement>('.vibe');
      const store = {
        get: () => {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        },
        set: (v: string) => {
          try {
            localStorage.setItem('theme', v);
          } catch {}
        },
      };
      const apply = (modern: boolean) => {
        if (modern) root.dataset.theme = 'modern';
        else delete root.dataset.theme;
        if (pill) {
          const label = (modern ? pill.dataset.toClassic : pill.dataset.toModern) ?? '';
          pill.textContent = (modern ? pill.dataset.classicShort : pill.dataset.modernShort) ?? '';
          pill.setAttribute('aria-label', label);
          pill.title = label;
          pill.setAttribute('aria-pressed', String(modern));
        }
      };
      const setTheme = (modern: boolean) => {
        apply(modern);
        store.set(modern ? 'modern' : 'classic');
      };
      apply(root.dataset.theme === 'modern');
      pill?.addEventListener('click', () => {
        setTheme(root.dataset.theme !== 'modern');
        if (vibe) vibe.hidden = true;
      });
      if (vibe) {
        const close = (modern: boolean) => {
          setTheme(modern);
          vibe.hidden = true;
          pill?.focus();
        };
        if (!store.get()) {
          vibe.hidden = false;
          vibe.querySelector<HTMLButtonElement>('.vibe-go')?.addEventListener('click', () => close(true));
          vibe.querySelector<HTMLButtonElement>('.vibe-no')?.addEventListener('click', () => close(false));
          vibe.querySelector<HTMLButtonElement>('.vibe-close')?.addEventListener('click', () => close(false));
          vibe.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') close(false);
          });
        }
      }
    </script>
    <script>
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const menu = document.getElementById('site-menu');
      if (btn && menu) {
        const set = (open: boolean) => {
          btn.setAttribute('aria-expanded', String(open));
          btn.setAttribute('aria-label', (open ? btn.dataset.close : btn.dataset.open) ?? '');
          document.documentElement.classList.toggle('menu-open', open);
          for (const el of document.querySelectorAll<HTMLElement>('main, footer, .skip, .home-nav, .lang-pill, .theme-pill, .vibe')) el.inert = open;
          if (open) menu.querySelector('a')?.focus();
        };
        btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
        menu.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) set(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
            set(false);
            btn.focus();
          }
        });
      }
    </script>
  </body>
</html>
